{
  "name": "@ramideltoro/nutsnews-worker-article-persistence",
  "version": "0.1.0",
  "description": "Deployable worker-uplift article persistence service shell for NutsNews.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramideltoro/nutsnews-worker-article-persistence.git"
  },
  "bugs": {
    "url": "https://github.com/ramideltoro/nutsnews-worker-article-persistence/issues"
  },
  "homepage": "https://github.com/ramideltoro/nutsnews-worker-article-persistence#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage *.tgz *.sbom.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sbom": "npm sbom --sbom-format=cyclonedx > nutsnews-worker-article-persistence.sbom.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "container:build": "docker build --pull=false --secret id=npm_token,env=NODE_AUTH_TOKEN -t nutsnews-worker-article-persistence:local .",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run sbom && npm run audit:prod"
  },
  "dependencies": {
    "@ramideltoro/nutsnews-worker-contracts": "1.0.0",
    "@ramideltoro/nutsnews-worker-runtime": "1.0.0",
    "amqplib": "^2.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24"
  }
}
